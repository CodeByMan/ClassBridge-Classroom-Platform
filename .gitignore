# Environment and secrets
/.env
/.env.*
!/.env.example
/auth.json

# PHP / Composer dependencies
/vendor/

# JavaScript dependencies and generated frontend assets
/node_modules/
/public/build/
/public/hot

# Public storage link or copied storage directory
/public/storage

# Laravel runtime files
/storage/*.key
/storage/debugbar/
/storage/logs/*
!/storage/logs/.gitignore
/storage/framework/cache/data/*
!/storage/framework/cache/data/.gitignore
/storage/framework/sessions/*
!/storage/framework/sessions/.gitignore
/storage/framework/testing/*
!/storage/framework/testing/.gitignore
/storage/framework/views/*
!/storage/framework/views/.gitignore
/bootstrap/cache/*.php
!/bootstrap/cache/.gitignore

# Runtime uploads
/storage/app/submissions/*
!/storage/app/submissions/.gitignore
/storage/app/public/images/*
!/storage/app/public/images/default.svg

# Local databases and test results
/database/*.sqlite
/database/*.sqlite-*
/.phpunit.result.cache
/.phpunit.cache/
/coverage/
/build/coverage/
/junit.xml

# Package-manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# IDEs and operating-system files
/.idea/
/.vscode/
/.fleet/
*.code-workspace
.DS_Store
Thumbs.db
desktop.ini

# Temporary, patch, and backup files
*.tmp
*.temp
*.bak
*.backup
*.backup-*
*.orig
*.rej
*~
