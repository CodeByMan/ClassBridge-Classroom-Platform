{
    "name": "muhammad-ali-nawaz/classbridge",
    "type": "project",
    "description": "ClassBridge, a security-hardened Laravel classroom collaboration portfolio application.",
    "keywords": [
        "classbridge",
        "laravel",
        "classroom",
        "portfolio",
        "livewire"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^12.64",
        "laravel/socialite": "^5.29",
        "laravel/tinker": "^3.0",
        "livewire/livewire": "^3.8",
        "wire-elements/modal": "^3.0.4"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24",
        "laravel/pint": "^1.29",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.0",
        "phpunit/phpunit": "^11.5",
        "spatie/laravel-ignition": "^2.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "test": [
            "@php artisan test"
        ],
        "verify": [
            "@composer validate --strict",
            "@composer check-platform-reqs",
            "@composer audit --locked --abandoned=report",
            "@php artisan test",
            "@php vendor/bin/pint --test"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {}
    },
    "authors": [
        {
            "name": "Muhammad Ali Nawaz",
            "role": "Maintainer"
        }
    ]
}
